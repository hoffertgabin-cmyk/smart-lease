# Copier ce fichier en .env.local (développement) et renseigner les mêmes variables dans Vercel (Production).

# URL publique du site, sans slash final. Sert au sitemap, aux balises canoniques et aux images de partage.
NEXT_PUBLIC_SITE_URL=https://www.smartlease.fr

# Envoi des formulaires (contact, recherche personnalisée, reprise) via https://resend.com
# Sans clé : en développement les messages sont affichés dans le terminal ; en production l'envoi échoue proprement.
RESEND_API_KEY=
# Expéditeur : adresse d'un domaine vérifié dans Resend (ex. smartlease.lu)
MAIL_FROM="Site Smart Lease <site@smartlease.lu>"
# Destinataire des demandes
MAIL_TO=contact@smartlease.lu

# Facultatif : flux Instagram de la page d'accueil (jeton longue durée de l'API Instagram).
# Sans jeton, la section affiche un lien vers le compte Instagram.
INSTAGRAM_ACCESS_TOKEN=
